flowchart TB
  accTitle: WhyLine Denver processing and serving
  accDescr: Public sources flow into GCS and BigQuery, through dbt, then FastAPI and Next.js.
  sources["15 batch ingestors"] --> raw["GCS raw files and manifests"]
  stream["Stream poller VM: RTD realtime every 15 s, stop visits every 15 min"] --> raw
  stream --> archive["GCS Coldline: every feed payload"]
  raw --> loader["Explicit-schema loader and MD5 tracking"]
  loader --> bronze["BigQuery raw_denver: 27 registered tables"]
  bronze --> silver["dbt stg_denver (silver): 25 staging models"]
  silver --> core["dbt core_denver (gold core): 8 dims, 21 facts incl. stop visits, 4 bridges"]
  core --> gold["dbt mart_denver (gold serving): 35 marts, 22 in the app"]
  gold --> api["FastAPI: validate, dry-run and query BigQuery"]
  api --> web["Next.js dashboard on Vercel"]
  scheduler["Cloud Scheduler: 15-minute load"] -.-> loader
  nightly["GitHub nightly chain: ingest, then dbt build and tests"] -.-> sources
  nightly -.-> silver
