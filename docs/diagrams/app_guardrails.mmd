flowchart TD
  accTitle: Dashboard SQL generation and execution
  accDescr: Questions go through provider generation and validation; execution always validates again and dry-runs on BigQuery.
  question["Question and filters"] --> prompt["Schema brief plus user input"]
  prompt --> provider["Gemini or local stub"]
  provider --> guard["Server SQL validation and table qualification"]
  prebuilt["Ready-made question SQL"] --> guard
  guard --> editor["Review and edit SQL in browser"]
  editor --> validate["Validation endpoint: BigQuery dry run and estimate"]
  validate --> run["Query endpoint revalidates SQL"]
  run --> bq["BigQuery dry run and API query byte cap"]
  bq --> display["Result enrichment, display limit, table/chart/map"]
  display --> csv["Displayed-result CSV"]
  note["Regex guardrails supplement permissions; limits and freshness are separate checks"] -.-> run
